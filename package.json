{
  "name": "craftindex",
  "version": "2.6.1",
  "description": "CraftIndex is a Minecraft resource library and modpack builder for discovering, organizing, and bulk-downloading mods, plugins, resource packs, shaders, and data packs.",
  "main": "server.js",
  "homepage": "https://craftindex.inlooker.top",
  "repository": {
    "type": "git",
    "url": "https://github.com/ArataInlooker/CraftIndex.git"
  },
  "scripts": {
    "start": "node server.js",
    "build": "node build_pages.js && node build_sitemap.js && node sync_standalone.js",
    "build:pages": "node build_pages.js",
    "build:routes": "node build_static_routes.js",
    "build:standalone": "node sync_standalone.js",
    "build:docs": "node build_docs.js",
    "test": "node tests/run_all_tests.js",
    "test:unit": "node tests/test_pages_function.js",
    "test:pages": "node tests/verify_pages_deployment.js",
    "test:zip": "node tests/verify_zip_roundtrip.js",
    "test:persistence": "node tests/verify_binary_persistence.js",
    "test:routing": "node tests/verify_browser_routing.js",
    "test:visual": "node tests/verify_header_logo_and_favicon.js",
    "test:contrast": "node tests/audit_light_theme_contrast.js",
    "test:scroll-isolation": "node tests/test_scroll_isolation.js",
    "test:release-routing": "node tests/release_gate_routing.js",
    "test:qa-screenshots": "node tests/capture_remediation_screenshots.js"
  },
  "keywords": [
    "craftindex",
    "minecraft",
    "resource-library",
    "modpack-builder",
    "mods",
    "plugins",
    "resource-packs",
    "shaders",
    "data-packs",
    "bulk-downloader"
  ],
  "author": "Arata Inlooker <aratainlooker@gmail.com>",
  "private": true,
  "license": "All Rights Reserved (Proprietary)"
}
